<Window x:Class="VortexDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VortexDownloader.UI.ViewModels"
        xmlns:svc="clr-namespace:VortexDownloader.UI.Services"
        xmlns:views="clr-namespace:VortexDownloader.UI.Views"
        mc:Ignorable="d"
        Title="VortexDownloader - Yüksek Hızlı İndirme Yöneticisi" 
        Height="660" Width="1040"
        MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/vortex_app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="AppTaskbarInfo"/>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Gradient Button -->
        <Style x:Key="PrimarySidebarButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media / Video Action Button (Soft Loft Card Style with Sage Green Accent) -->
        <Style x:Key="MediaSidebarButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Category Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="0,6,6,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryDarkButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Item Action Button -->
        <Style x:Key="ItemActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Toggle Button -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource PrimaryAccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Fully Themed ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          ClickMode="Press" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource DarkComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Left" IsHitTestVisible="false" 
                                              Margin="10,0,24,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        SnapsToDevicePixels="true" Margin="0,3,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" 
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plugin card: round icon button (favorite star), centered glyph -->
        <Style x:Key="PluginIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="Transparent">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Content" Value="★">
                    <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Plugin card: quiet secondary button that turns red only on hover -->
        <Style x:Key="PluginGhostDangerButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="{DynamicResource ProgressBarForegroundBrush}" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style (Guaranteed 10px spacing between check border and text) -->
        <Style TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" Grid.Column="0" Width="16" Height="16" CornerRadius="4" 
                                    Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                    Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M 3 8 L 6.5 11.5 L 13 4" Stroke="{DynamicResource AccentHighlightBrush}" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN APPLICATION LAYOUT -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="220"/>
            <!-- Center Main Work Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Primary Action -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Categories -->
                    <RowDefinition Height="*"/>
                    <!-- Sidebar Bottom: Speed & Settings (Motrix style) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Brand Header with Rotating Vortex Animation -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Border Width="30" Height="30" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Border.RenderTransform>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinVortexStory">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinVortexStory"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="pack://application:,,,/Assets/vortex_logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_BrandTitle}" FontSize="15" FontWeight="Black" Foreground="{DynamicResource AccentHighlightBrush}"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static svc:AppInfo.VersionText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DOWNLOAD MANAGER" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Primary Action Buttons -->
                <StackPanel Grid.Row="1" Margin="0,16,0,16">
                    <Button x:Name="BtnNewDownload" Style="{StaticResource PrimarySidebarButton}" 
                            Margin="0,0,0,8" Click="BtnNewDownload_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str_NewDownload}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <!-- Favorite plugins: quick access, filled from the Plugins page via the star -->
                    <StackPanel Visibility="{Binding HasFavoritePlugins, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="FAVORİ EKLENTİLER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,8,0,5"/>
                        <ItemsControl ItemsSource="{Binding FavoritePluginCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding OpenCommand}" Height="34" ToolTip="{Binding Description}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontSize="11" Width="18" Foreground="{DynamicResource AccentHighlightBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- 3. Navigation Categories (Clickable Filter Buttons) with ScrollViewer -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-8,10" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Categories}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8"/>

                        <!-- Category: All Tasks Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                Command="{Binding SetFilterCommand}" CommandParameter="All">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📥" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_AllTasks}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Category: Downloading Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                Command="{Binding SetFilterCommand}" CommandParameter="Downloading">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Downloading}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Category: Paused Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                Command="{Binding SetFilterCommand}" CommandParameter="Paused">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⏸" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Paused}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PausedDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Category: Completed Button -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" 
                                Command="{Binding SetFilterCommand}" CommandParameter="Completed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✅" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Completed}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompletedDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- FILE TYPES SECTION -->
                        <TextBlock Text="{DynamicResource Str_FileTypes}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,14,0,8"/>

                        <!-- Compressed (Zip/Rar/7z) -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Compressed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📦" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Compressed}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompressedCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Documents -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Documents">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📄" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Documents}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DocumentsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Music -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Music">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎵" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Music}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding MusicCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Programs -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Programs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="💻" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Programs}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgramsCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Video -->
                        <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Video">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎬" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource Str_Video}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding VideoCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. Sidebar Bottom: Disk Space, Speed & Settings -->
                <StackPanel Grid.Row="3">
                    <!-- Live Speed Card with sparkline (disk-space card removed) -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{DynamicResource Str_DownloadSpeed}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalSpeedFormatted}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SpeedBars}" Height="14" Margin="0,5,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Opacity="0.8"
                                                Background="{DynamicResource AccentHighlightBrush}" CornerRadius="2,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding FreeDiskSpaceText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Plugins hub entry (replaces the standalone YouTube sidebar item) -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}" Command="{Binding SetFilterCommand}" CommandParameter="Plugins"
                            Margin="0,0,0,2" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧩" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Eklentiler" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings" Style="{StaticResource SidebarNavButtonStyle}" 
                            Click="BtnSettings_Click" Margin="0" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙️" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource Str_Settings}" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== RIGHT MAIN WORK AREA ==================== -->
        <Grid Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
            <Grid.RowDefinitions>
                <!-- Top Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Downloads Content or Clean Empty State -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP TOOLBAR -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="18,10,18,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Context Header (Title + Preferences) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Action Toolbar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ROW 0: Title & Count on Left, Speed Limiter & Auto Shutdown on Right -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Section Title & Count Badge -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Middle Spacer -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: Speed Limiter & Auto Shutdown -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Title & Badge -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilterTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredDownloadsCount, StringFormat='{}{0} Görev'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Right: Quick Preferences (Speed & Shutdown) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Search -->
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="30" Margin="0,0,12,0"
                                     VerticalContentAlignment="Center" Padding="8,0" FontSize="12"
                                     Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     ToolTip="Dosya adı veya URL ara"/>
                            <!-- Speed Limit Dropdown -->
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⚡" FontSize="11" Foreground="#10B981" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                    <ComboBox ItemsSource="{Binding SpeedLimitOptions}" SelectedItem="{Binding SelectedSpeedLimit}" Width="82" Height="24" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Auto Shutdown Checkbox -->
                            <CheckBox Content="{DynamicResource Str_ShutdownWhenDone}"
                                      IsChecked="{Binding ShutdownWhenCompleted, Mode=TwoWay}"
                                      VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"
                                      ToolTip="Tüm indirmeler tamamlandığında bilgisayarı otomatik kapatır"/>
                        </StackPanel>
                    </Grid>

                    <!-- ROW 1: Action Toolbar (Full width to breathe, never cut off!) -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3,2" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <!-- Start All -->
                            <Button Style="{StaticResource SecondaryDarkButton}" BorderThickness="0" Background="Transparent" Padding="12,5" Command="{Binding StartAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_StartAll}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource CardBorderBrush}" Margin="2,0"/>

                            <!-- Pause All -->
                            <Button Style="{StaticResource SecondaryDarkButton}" BorderThickness="0" Background="Transparent" Padding="12,5" Command="{Binding PauseAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⏸" Foreground="#FBBF24" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_PauseAll}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource CardBorderBrush}" Margin="2,0"/>

                            <!-- Clear Completed -->
                            <Button Style="{StaticResource SecondaryDarkButton}" BorderThickness="0" Background="Transparent" Padding="12,5" Command="{Binding ClearCompletedCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧹" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Str_ClearCompleted}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="14" Fill="{DynamicResource CardBorderBrush}" Margin="2,0"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. MAIN DOWNLOADS LIST OR CLEAN MINIMALIST EMPTY STATE -->
            <Grid Grid.Row="1">
                <!-- Clean Minimalist Empty State (Shown when 0 downloads) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" 
                        Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="32,28">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Minimalist Icon -->
                        <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Text -->
                        <TextBlock Text="{DynamicResource Str_EmptyTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str_EmptyDesc}" 
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,18" TextWrapping="Wrap"/>

                        <!-- Hint chip -->
                        <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_EmptyHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Active Downloads List (Shown when downloads exist) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                    <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                <!-- Modern Sleek Download Card -->
                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
                                        CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: File Name, Badge & Action Buttons -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- File Name & URL (Dynamic Responsive) -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                                            <!-- File type tile -->
                                            <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,12,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource BadgeBackgroundBrush}">
                                                <TextBlock Text="{Binding ExtensionLabel}" FontSize="11" FontWeight="ExtraBold"
                                                           Foreground="{DynamicResource BadgeTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                                                    <!-- Status Badge -->
                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" ToolTip="{Binding ErrorMessage}">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            </StackPanel>

                                            <!-- Item Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Pause Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="⏸ Duraklat" 
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Resume Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="▶ Devam Et" 
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Open Folder Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="📁 Klasör" 
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Delete Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="🗑 Sil" 
                                                        Foreground="#F87171"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Chunk map (multi-chunk) or single progress bar -->
                                        <!-- On completion the chunk segments cross-fade into one merged bar -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,8" Height="8">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasChunkMap}" Value="True">
                                                            <Setter Property="Opacity" Value="0"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.7"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding ChunkFractions}" Margin="0,0,0,8"
                                                      Visibility="{Binding HasChunkMap, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                            <Setter Property="Opacity" Value="0"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.7"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ProgressBar Value="{Binding Mode=OneWay}" Minimum="0" Maximum="1" Height="8" Margin="0,0,3,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Row 2: Stats (Downloaded / Total, Percent, Speed, Chunks) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Downloaded / Total Size -->
                                            <TextBlock Grid.Column="0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                <Run Text="{Binding DownloadedBytesFormatted, Mode=OneWay}"/>
                                                <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Run Text="{Binding TotalBytesFormatted, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Progress Percent & Speed -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}%', Mode=OneWay}" 
                                                           FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentHighlightBrush}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding SpeedFormatted, Mode=OneWay}" 
                                                           FontSize="11" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding EtaFormatted, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Chunks indicator -->
                                            <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChunksCount, StringFormat='{}{0} Parça'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Row 3: Error detail (Failed only) -->
                                        <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource StatusErrorBrush}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Plugins hub: covers toolbar + list while the "Plugins" view is active -->
            <Grid Grid.RowSpan="2" Background="{DynamicResource WindowBackgroundBrush}"
                  Visibility="{Binding IsPluginsView, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
                    <StackPanel>
                        <TextBlock Text="Eklentiler" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Vortex'in yeteneklerini genişleten modüller. Yeni eklentiler burada görünür."
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,20"/>
                        <ItemsControl ItemsSource="{Binding PluginCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="300" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,14,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BadgeBackgroundBrush}">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="16" Foreground="{DynamicResource AccentHighlightBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding VersionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="{Binding FavoriteGlyph}" Command="{Binding ToggleFavoriteCommand}"
                                                        Style="{StaticResource PluginIconButtonStyle}" VerticalAlignment="Top"
                                                        ToolTip="Favorilere ekle / çıkar (sol menüde görünür)"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MinHeight="48"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Content="Aç" Command="{Binding OpenCommand}" Style="{StaticResource PrimarySidebarButton}" Height="34"/>
                                                <Button Grid.Column="1" Content="Kaldır" Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource PluginGhostDangerButtonStyle}" Margin="8,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- Placeholder for future plugins -->
                        <Border Width="300" HorizontalAlignment="Left" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="＋ Eklenti ekle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Eklenti dosyasının (plugin.json) https bağlantısını yapıştırın. Eklentiler kod çalıştırmaz, yalnızca site listesi tanımlar."
                                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10"/>
                                <TextBox x:Name="TxtPluginUrl" Height="32" Padding="8,0" VerticalContentAlignment="Center" FontSize="12"
                                         Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"/>
                                <Button x:Name="BtnInstallPlugin" Content="Ekle" Click="BtnInstallPlugin_Click" Style="{StaticResource PrimarySidebarButton}"
                                        Height="34" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

