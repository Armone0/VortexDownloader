<Window x:Class="VortexDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VortexDownloader.UI.ViewModels"
        mc:Ignorable="d"
        Title="VortexDownloader - Yüksek Hızlı İndirme Yöneticisi" 
        Height="660" Width="1040"
        MinHeight="520" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/vortex_app.ico"
        Background="#080C14"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Primary Gradient Button -->
        <Style x:Key="PrimarySidebarButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#6366F1" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Category Button Style -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="Transparent" BorderThickness="2,0,0,0" CornerRadius="0,6,6,0" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#131B2A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C273D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Dark Button -->
        <Style x:Key="SecondaryDarkButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#131B2A"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="#202C42" BorderThickness="1" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C273D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#334566"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F1622"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Item Action Button -->
        <Style x:Key="ItemActionButton" TargetType="Button">
            <Setter Property="Background" Value="#162032"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="#253550" BorderThickness="1" CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22314D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#385078"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#111927"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#4B6085"/>
                    <Setter Property="Background" TargetName="templateRoot" Value="#1C273C"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="#6366F1"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Fully Themed Dark ComboBox (Working Popup Binding) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#131B2A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#253550"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          ClickMode="Press" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource DarkComboBoxToggleButton}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Left" IsHitTestVisible="false" 
                                              Margin="10,0,24,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#111827" BorderBrush="#253550" 
                                        BorderThickness="1" CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        SnapsToDevicePixels="true" Margin="0,3,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Items -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" 
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2A3E"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="#131B2A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="#00F2FE" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN TWO-COLUMN APPLICATION LAYOUT -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar Navigation -->
            <ColumnDefinition Width="220"/>
            <!-- Right Main Work Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="#0B0F19" BorderBrush="#162032" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Primary Action -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Categories -->
                    <RowDefinition Height="*"/>
                    <!-- Engine & Speed Status Widget -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Brand Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Image Source="pack://application:,,,/Assets/vortex_logo.png" Width="30" Height="30" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="VORTEX" FontSize="15" FontWeight="Black" Foreground="#00F2FE"/>
                            <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="DOWNLOAD MANAGER" FontSize="8" FontWeight="Bold" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 2. Primary Action Button -->
                <Button Grid.Row="1" x:Name="BtnNewDownload" Style="{StaticResource PrimarySidebarButton}" 
                        Margin="0,18,0,18" Click="BtnNewDownload_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="＋" FontSize="14" FontWeight="Bold" Margin="0,0,6,0"/>
                        <TextBlock Text="Yeni İndirme Ekle" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- 3. Navigation Categories (Clickable Filter Buttons) -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="KATEGORİLER" FontSize="10" FontWeight="Bold" Foreground="#475569" Margin="8,0,0,8"/>

                    <!-- Category: All Tasks Button -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}" 
                            Command="{Binding SetFilterCommand}" CommandParameter="All">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📥" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Tüm Görevler" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TotalDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Category: Downloading Button -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Downloading">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="İndirilenler" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#064E3B" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Category: Paused Button -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Paused">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⏸" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Duraklatılanlar" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PausedDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Category: Completed Button -->
                    <Button Style="{StaticResource SidebarNavButtonStyle}" 
                            Command="{Binding SetFilterCommand}" CommandParameter="Completed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✅" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Tamamlananlar" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="10" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CompletedDownloadsCount}" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- 4. Engine & Speed Status Widget -->
                <Border Grid.Row="3" Background="#0F1626" BorderBrush="#1C273D" BorderThickness="1" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                        <!-- Speed Row -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="İndirme Hızı:" FontSize="11" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TotalSpeedFormatted}" HorizontalAlignment="Right" 
                                       FontWeight="Bold" FontSize="12" Foreground="#34D399"/>
                        </Grid>

                        <!-- Port status -->
                        <Border Background="#162033" CornerRadius="4" Padding="6,3" Margin="0,2,0,0">
                            <TextBlock Text="🌐 Tarayıcı Köprüsü: Port 19741" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== RIGHT MAIN WORK AREA ==================== -->
        <Grid Grid.Column="1" Background="#070A11">
            <Grid.RowDefinitions>
                <!-- Top Toolbar -->
                <RowDefinition Height="Auto"/>
                <!-- Downloads Content or Clean Empty State -->
                <RowDefinition Height="*"/>
                <!-- Bottom Engine Stats Footer -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. TOP TOOLBAR -->
            <Border Grid.Row="0" Background="#0C101A" BorderBrush="#162032" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- View Title & Count -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Global Controls -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Breadcrumb / Section Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FilterTitle}" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <Border Background="#131B2A" BorderBrush="#1F2A3F" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalDownloadsCount, StringFormat='{}{0} Görev'}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Engine Controls & Speed Limiter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Start All Button -->
                        <Button Style="{StaticResource SecondaryDarkButton}" Margin="0,0,8,0"
                                Command="{Binding StartAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="▶" Margin="0,0,5,0" Foreground="#34D399"/>
                                <TextBlock Text="Tümünü Başlat"/>
                            </StackPanel>
                        </Button>

                        <!-- Pause All Button -->
                        <Button Style="{StaticResource SecondaryDarkButton}" Margin="0,0,14,0"
                                Command="{Binding PauseAllCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⏸" Margin="0,0,5,0" Foreground="#FBBF24"/>
                                <TextBlock Text="Tümünü Duraklat"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <Rectangle Width="1" Height="18" Fill="#1E283D" Margin="0,0,14,0"/>

                        <!-- Speed Limit Selector -->
                        <TextBlock Text="Hız Sınırı:" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding SpeedLimitOptions}" SelectedItem="{Binding SelectedSpeedLimit}" Width="105"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. MAIN DOWNLOADS LIST OR CLEAN MINIMALIST EMPTY STATE -->
            <Grid Grid.Row="1">
                <!-- Clean Minimalist Empty State (Shown when 0 downloads) -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" 
                        Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}"
                        Background="#0D121F" BorderBrush="#182338" BorderThickness="1" CornerRadius="14" Padding="32,28">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Minimalist Icon -->
                        <Border Width="52" Height="52" CornerRadius="26" Background="#131B2C" BorderBrush="#1F2C46" BorderThickness="1" 
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Text="📥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Text -->
                        <TextBlock Text="Henüz indirme eklenmedi" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                        <TextBlock Text="İndirme başlatmak için sol menüden Yeni İndirme'ye tıklayın veya Chrome/Edge eklentisiyle indirin." 
                                   FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,18" TextWrapping="Wrap"/>

                        <!-- Hint chip -->
                        <Border Background="#101726" BorderBrush="#1B253B" BorderThickness="1" CornerRadius="6" Padding="10,6" HorizontalAlignment="Center">
                            <TextBlock Text="💡 Chrome &amp; Edge tarayıcı eklentisi indirmeleri otomatik yakalar" FontSize="11" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Active Downloads List (Shown when downloads exist) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                    <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                                <!-- Modern Sleek Download Card -->
                                <Border Background="#0E1320" BorderBrush="#182236" BorderThickness="1" 
                                        CornerRadius="8" Padding="16,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Row 0: File Name, Badge & Action Buttons -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- File Name & URL -->
                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,10,0"/>
                                                    <!-- Status Badge -->
                                                    <Border Background="{Binding StatusBgColor}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#475569" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="520"/>
                                            </StackPanel>

                                            <!-- Item Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Pause Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="⏸ Duraklat" 
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Resume Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="▶ Devam Et" 
                                                        Margin="0,0,6,0"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Open Folder Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="📁 Klasör" 
                                                        Margin="0,0,6,0"
                                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Delete Button -->
                                                <Button Style="{StaticResource ItemActionButton}" Content="🗑 Sil" 
                                                        Foreground="#F87171"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Row 1: Smooth Progress Bar -->
                                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,8"/>

                                        <!-- Row 2: Stats (Downloaded / Total, Percent, Speed, Chunks) -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Downloaded / Total Size -->
                                            <TextBlock Grid.Column="0" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center">
                                                <Run Text="{Binding DownloadedBytesFormatted, Mode=OneWay}"/>
                                                <Run Text=" / " Foreground="#475569"/>
                                                <Run Text="{Binding TotalBytesFormatted, Mode=OneWay}"/>
                                            </TextBlock>

                                            <!-- Progress Percent & Speed -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:F1}%', Mode=OneWay}" 
                                                           FontWeight="Bold" FontSize="11" Foreground="#00F2FE" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding SpeedFormatted, Mode=OneWay}" 
                                                           FontSize="11" Foreground="#34D399" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <!-- Chunks indicator -->
                                            <Border Grid.Column="2" Background="#131B2A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ChunksCount, StringFormat='{}{0} Parça'}" FontSize="10" Foreground="#64748B"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 3. BOTTOM ENGINE STATS FOOTER -->
            <Border Grid.Row="2" Background="#080C14" BorderBrush="#141C2B" BorderThickness="0,1,0,0" Padding="20,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Dinamik Çok Kanallı Motor • SocketsHttpHandler • Zero-Alloc Buffer • Win11 Native Shell" 
                               FontSize="10" Foreground="#475569" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0"/>
                        <TextBlock Text="Motor Aktif" FontSize="10" Foreground="#10B981" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>