<Window x:Class="VortexDownloader.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:VortexDownloader.UI.ViewModels"
        mc:Ignorable="d"
        Title="VortexDownloader - Modern High-Speed Engine" 
        Height="620" Width="980"
        MinHeight="480" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/vortex_app.ico"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Flat Dark Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Icon Button -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" Background="#6366F1" CornerRadius="3" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Content / Downloads List -->
            <RowDefinition Height="*"/>
            <!-- Status Bar Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Brand & Primary Actions -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/vortex_logo.png" Width="38" Height="38" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
                        <TextBlock Text="VORTEX" FontSize="16" FontWeight="Black" Foreground="#00F2FE"/>
                        <TextBlock Text="DOWNLOADER" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" Margin="0,-2,0,0"/>
                    </StackPanel>

                    <!-- New Download Button -->
                    <Button x:Name="BtnNewDownload" Style="{StaticResource ActionButtonStyle}" 
                            Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" 
                            Content="＋ Yeni İndirme" Margin="0,0,10,0" Click="BtnNewDownload_Click"/>

                    <!-- Start All Button -->
                    <Button Style="{StaticResource ActionButtonStyle}" 
                            Background="#1E293B" Foreground="#F8FAFC" BorderThickness="1" BorderBrush="#334155"
                            Content="▶ Tümünü Başlat" Margin="0,0,8,0" Command="{Binding StartAllCommand}"/>

                    <!-- Pause All Button -->
                    <Button Style="{StaticResource ActionButtonStyle}" 
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="1" BorderBrush="#334155"
                            Content="⏸ Tümünü Durdur" Command="{Binding PauseAllCommand}"/>
                </StackPanel>

                <!-- Right: Speed Limiter & Global Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Speed Limit Selector -->
                    <TextBlock Text="Hız Sınırı:" VerticalAlignment="Center" FontSize="12" Foreground="#94A3B8" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding SpeedLimitOptions}" SelectedItem="{Binding SelectedSpeedLimit}"
                              Width="105" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155"
                              Padding="8,6" VerticalContentAlignment="Center" Margin="0,0,20,0"/>

                    <!-- Realtime Global Speed Meter -->
                    <Border Background="#1E293B" CornerRadius="8" Padding="14,6" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⚡" Foreground="#34D399" FontSize="13" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TotalSpeedFormatted}" FontWeight="Bold" FontSize="13" Foreground="#34D399"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN DOWNLOADS LIST & EMPTY STATE -->
        <Grid Grid.Row="1">
            <!-- Empty State Hero (Visible when no downloads) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="580" Margin="24"
                    Visibility="{Binding HasNoDownloads, Converter={StaticResource BoolToVis}}"
                    Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="16" Padding="36,32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Glowing Logo Container -->
                    <Border Width="84" Height="84" CornerRadius="20" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00F2FE" Offset="0"/>
                                <GradientStop Color="#7F00FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" Color="#00F2FE" Opacity="0.4" ShadowDepth="0"/>
                        </Border.Effect>
                        <Image Source="pack://application:,,,/Assets/vortex_logo.png" Margin="14" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Title & Tagline -->
                    <TextBlock Text="VORTEX DOWNLOADER" FontSize="20" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                    <TextBlock Text="Yüksek hızlı, dinamik çok kanallı indirme motoru hazır." FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,6,0,20"/>

                    <!-- CTA Button -->
                    <Button Style="{StaticResource ActionButtonStyle}" 
                            Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" 
                            Content="⚡ Yeni İndirme Başlat" Padding="24,12" FontSize="14" FontWeight="Bold"
                            HorizontalAlignment="Center" Margin="0,0,0,22" Click="BtnNewDownload_Click"/>

                    <!-- Feature Pillars Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Feature 1 -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚡ 32 Parça" FontSize="12" FontWeight="Bold" Foreground="#00F2FE" HorizontalAlignment="Center"/>
                                <TextBlock Text="Dinamik Bölme" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 2 -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="4,0,4,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🌐 Tarayıcı Köprüsü" FontSize="12" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                <TextBlock Text="Chrome / Edge" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Feature 3 -->
                        <Border Grid.Column="2" Background="#1E293B" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🛡️ Bellek Koruması" FontSize="12" FontWeight="Bold" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                                <TextBlock Text="RAM/Disk Güvenliği" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- System Tray Note -->
                    <TextBlock Text="💡 İpucu: Uygulama kapatıldığında Windows sistem tepsisinde (saat yanı) çalışır." 
                               FontSize="11" Foreground="#64748B" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20">
                <ItemsControl ItemsSource="{Binding Downloads}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                            <!-- Single Download Card -->
                            <Border Background="#151D2F" BorderBrush="#1E293B" BorderThickness="1" 
                                    CornerRadius="10" Padding="18,16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: File Name, Badge & Actions -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- File info & URL -->
                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" Margin="0,0,10,0"/>
                                                <!-- Status Badge -->
                                                <Border Background="{Binding StatusBgColor}" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" MaxWidth="500"/>
                                        </StackPanel>

                                        <!-- Item Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Pause Button -->
                                            <Button Style="{StaticResource IconButton}" Content="⏸ Duraklat" 
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.PauseTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Resume Button -->
                                            <Button Style="{StaticResource IconButton}" Content="▶ Devam Et" 
                                                    Margin="0,0,6,0"
                                                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.ResumeTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Open Folder Button -->
                                            <Button Style="{StaticResource IconButton}" Content="📁 Klasör" 
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>

                                            <!-- Delete Button -->
                                            <Button Style="{StaticResource IconButton}" Content="🗑 Sil" 
                                                    Foreground="#F87171"
                                                    Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row 1: Smooth Progress Bar -->
                                    <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Margin="0,0,0,8"/>

                                    <!-- Row 2: Stats (Downloaded / Total, Percent, Speed, Chunks) -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Downloaded / Total Size -->
                                        <TextBlock Grid.Column="0" Text="{Binding FormattedProgress}" FontSize="12" Foreground="#94A3B8"/>

                                        <!-- Dynamic Chunk Count indicator -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding ChunkInfo}" FontSize="11" Foreground="#A5B4FC" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Instant Download Speed -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding FormattedSpeed}" FontSize="12" FontWeight="Bold" Foreground="#34D399"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Toplam Görev: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalDownloadsCount}" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,12,0"/>
                    <TextBlock Text="Aktif İndirme: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ActiveDownloadsCount}" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="IDM Algoritması • SocketsHttpHandler • Zero-Alloc Buffer" FontSize="11" Foreground="#475569"/>
            </Grid>
        </Border>
    </Grid>
</Window>
