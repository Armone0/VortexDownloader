<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\VortexDownloader.Core\VortexDownloader.Core.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>VortexDownloader</AssemblyName>
    <ApplicationIcon>Assets\vortex_app.ico</ApplicationIcon>
    <Version>1.8.0</Version>
    <AssemblyVersion>1.8.0.0</AssemblyVersion>
    <FileVersion>1.8.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\vortex_app.ico" />
    <Resource Include="Assets\vortex_tray.ico" />
    <Resource Include="Assets\vortex_logo.png" />
    <Resource Include="Assets\vortex_logo.svg" />
  </ItemGroup>

</Project>
