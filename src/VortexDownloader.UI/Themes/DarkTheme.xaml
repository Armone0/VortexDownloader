<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- VORTEXDOWNLOADER - SOFT LOFT DARK THEME PALETTE                           -->
    <!-- ========================================================================= -->

    <!-- Core Palette Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#071B2B"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0B1320"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#0E1626"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#167D8D"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#131E30"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#167D8D"/>
    <SolidColorBrush x:Key="AccentHighlightBrush" Color="#B9E4E8"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EEEEEE"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <!-- Additional UI & Status Brushes -->
    <SolidColorBrush x:Key="DividerBrush" Color="#167D8D" Opacity="0.3"/>
    <SolidColorBrush x:Key="HoverTintBrush" Color="#167D8D" Opacity="0.2"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#167D8D" Opacity="0.35"/>
    <SolidColorBrush x:Key="IconBrush" Color="#B9E4E8"/>
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="#B9E4E8"/>
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#167D8D" Opacity="0.35"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#B9E4E8"/>

    <SolidColorBrush x:Key="StatusDownloadingBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#F87171"/>

</ResourceDictionary>
