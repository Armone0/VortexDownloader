<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- VORTEXDOWNLOADER - SOFT LOFT LIGHT THEME PALETTE                          -->
    <!-- ========================================================================= -->

    <!-- Core Palette Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFCED8"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFBAC8"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFDDDD"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E5A6B4"/>
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFF4DE"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#C94A68"/>
    <SolidColorBrush x:Key="AccentHighlightBrush" Color="#FFE8C4"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2A1B24"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A3E4D"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A6E7D"/>

    <!-- Additional UI & Status Brushes -->
    <SolidColorBrush x:Key="DividerBrush" Color="#E5A6B4" Opacity="0.5"/>
    <SolidColorBrush x:Key="HoverTintBrush" Color="#FFF4DE" Opacity="0.8"/>
    <SolidColorBrush x:Key="SelectedRowBrush" Color="#FFBAC8" Opacity="0.5"/>
    <SolidColorBrush x:Key="IconBrush" Color="#C94A68"/>
    <SolidColorBrush x:Key="ProgressBarForegroundBrush" Color="#C94A68"/>
    <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#FFF4DE"/>
    <SolidColorBrush x:Key="BadgeTextBrush" Color="#5A3E4D"/>

    <SolidColorBrush x:Key="StatusDownloadingBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="#059669"/>
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#DC2626"/>

</ResourceDictionary>
