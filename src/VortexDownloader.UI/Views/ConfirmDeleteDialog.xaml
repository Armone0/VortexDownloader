<Window x:Class="VortexDownloader.UI.Views.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndirmeyi Sil"
        Width="468" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="26" Color="#000000" Opacity="0.5" ShadowDepth="4"/>

        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteFileCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="row" Background="Transparent" CornerRadius="8" Padding="10,9"
                                BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource TextMutedBrush}" Background="Transparent" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{DynamicResource WindowBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource StatusErrorBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Shadow on its own layer so the card text stays crisp (an Effect would rasterize it) -->
    <Grid>
        <Border Margin="14" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}" Effect="{StaticResource WindowShadow}" IsHitTestVisible="False"/>
        <Border Margin="14" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <StackPanel Margin="22,20,22,20">

                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42" VerticalAlignment="Top">
                        <Border CornerRadius="11" Background="{DynamicResource StatusErrorBrush}" Opacity="0.16"/>
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{DynamicResource StatusErrorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="14,1,8,0">
                        <TextBlock Text="İndirmeyi sil" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Bu indirme listeden kaldırılacak." FontSize="12.5" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                            Width="30" Height="30" Padding="0" BorderThickness="0" Background="Transparent"
                            Foreground="{DynamicResource TextMutedBrush}" Style="{StaticResource DialogButton}"
                            VerticalAlignment="Top" Click="Cancel_Click" ToolTip="Kapat" IsTabStop="False"/>
                </Grid>

                <!-- File card -->
                <Border Margin="0,18,0,0" Padding="14,11" CornerRadius="10"
                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="FileNameText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="FileInfoText" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Delete-from-disk option (off by default: the safe choice) -->
                <CheckBox x:Name="DeleteFileCheck" Margin="0,12,0,0" Style="{StaticResource DeleteFileCheckBox}"
                          Checked="DeleteFileCheck_Changed" Unchecked="DeleteFileCheck_Changed">
                    <StackPanel>
                        <TextBlock Text="Dosyayı diskten de kalıcı olarak sil" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="WarningText" Text="Bu işlem geri alınamaz; dosya Geri Dönüşüm Kutusu'na gitmez."
                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </CheckBox>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="İptal" Style="{StaticResource DialogButton}" IsCancel="True" Click="Cancel_Click" MinWidth="92"/>
                    <Button x:Name="ConfirmButton" Content="Listeden kaldır" Style="{StaticResource DialogButton}" IsDefault="True"
                            Margin="10,0,0,0" MinWidth="140" Click="Confirm_Click"
                            Background="{DynamicResource ButtonPrimaryBgBrush}" Foreground="{DynamicResource ButtonPrimaryFgBrush}"
                            BorderBrush="{DynamicResource ButtonPrimaryBgBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
