<Window x:Class="VortexDownloader.UI.Views.ZipPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZIP Arşiv Önizleme - VortexDownloader" 
        Height="540" Width="760"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    
    <Window.Resources>
        <!-- Modern button style -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Column Header Style -->
        <Style x:Key="DarkColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <!-- Dark DataGrid Cell Style -->
        <Style x:Key="DarkDataGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark DataGrid Row Style -->
        <Style x:Key="DarkDataGridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content / Table Area -->
            <RowDefinition Height="*"/>
            <!-- Summary Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00F2FE" Offset="0"/>
                        <GradientStop Color="#4F46E5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="ZIP Arşiv İçeriği Önizleme" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="HTTP Range" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="UrlTextBlock" Text="Uzak arşiv taranıyor..." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Loading Indicator -->
            <Border x:Name="LoadingPanel" Background="#1E293B" CornerRadius="8" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#334155" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="280">
                    <ProgressBar IsIndeterminate="True" Height="6" Background="#0F172A" Foreground="#00F2FE" BorderThickness="0" Margin="0,0,0,14"/>
                    <TextBlock x:Name="LoadingStatusText" Text="ZIP Central Directory başlıkları HTTP Range ile okunuyor..." FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Error Banner -->
            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#3B1219" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#EF4444" BorderThickness="1" MaxWidth="500">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️ ZIP Önizleme Başarısız" FontSize="14" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ErrorMessageText" Text="Sunucu Range isteklerini desteklemiyor veya dosya geçerli bir ZIP arşivi değil." FontSize="12" Foreground="#FECACA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,12"/>
                    <Button Content="Yeniden Dene" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" HorizontalAlignment="Center" Click="RetryButton_Click" Padding="12,6"/>
                </StackPanel>
            </Border>

            <!-- DataGrid for ZIP entries -->
            <Border x:Name="DataGridContainer" Visibility="Collapsed" Background="#0B0F19" BorderBrush="#334155" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="ZipEntriesDataGrid"
                          SelectionMode="Single"
                          SelectionChanged="ZipEntriesDataGrid_SelectionChanged"
                          MouseDoubleClick="ZipEntriesDataGrid_MouseDoubleClick"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#1E293B"
                          VerticalGridLinesBrush="Transparent"
                          Background="Transparent"
                          RowBackground="#0B0F19"
                          AlternatingRowBackground="#111827"
                          BorderThickness="0"
                          ColumnHeaderStyle="{StaticResource DarkColumnHeader}"
                          CellStyle="{StaticResource DarkDataGridCell}"
                          RowStyle="{StaticResource DarkDataGridRow}"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <!-- Dosya Adı Column -->
                        <DataGridTemplateColumn Header="Dosya Adı" Width="*" MinWidth="220" SortMemberPath="FileName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding FileName}" Foreground="#F8FAFC" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Sıkıştırılmamış Boyut Column -->
                        <DataGridTextColumn Header="Sıkıştırılmamış Boyut" Binding="{Binding UncompressedSizeFormatted}" Width="150" SortMemberPath="UncompressedSize">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="Foreground" Value="#CBD5E1"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Sıkıştırılmış Boyut Column -->
                        <DataGridTextColumn Header="Sıkıştırılmış Boyut" Binding="{Binding CompressedSizeFormatted}" Width="140" SortMemberPath="CompressedSize">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Değiştirilme Tarihi Column -->
                        <DataGridTextColumn Header="Değiştirilme Tarihi" Binding="{Binding LastModifiedFormatted}" Width="140" SortMemberPath="LastModified">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="FontSize" Value="11"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Summary Row -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="6" Padding="12,8" Margin="0,12,0,14" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileCountSummaryText" Grid.Column="0" Text="Toplam: -" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock x:Name="ArchiveSizeSummaryText" Grid.Column="1" Text="Arşiv Boyutu: -" Foreground="#38BDF8" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Single entry extraction status -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <ProgressBar x:Name="ExtractProgressBar" Visibility="Collapsed" Height="4" Maximum="1"
                             Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentHighlightBrush}"
                             BorderThickness="0" Margin="0,0,0,4"/>
                <TextBlock x:Name="ExtractStatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Text="Bir dosyayı seçip yalnızca onu indirebilirsiniz."/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="CancelExtractButton" Content="İptal" Visibility="Collapsed"
                    Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" Click="CancelExtractButton_Click"/>
            <Button x:Name="ExtractEntryButton" Content="Seçili dosyayı indir" IsEnabled="False"
                    ToolTip="Arşivin tamamını indirmeden yalnızca seçili dosyayı indirir (çift tıklama da çalışır)"
                    Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" Click="ExtractEntryButton_Click"/>
            <Button x:Name="CloseButton" Content="Tamam" Background="#334155" Foreground="#CBD5E1" BorderThickness="0" Margin="0,0,10,0" Click="CloseButton_Click"/>
            <Button x:Name="StartDownloadButton" Content="İndirmeye Başla" Background="#4F46E5" Foreground="#FFFFFF" BorderThickness="0" IsEnabled="False" Click="StartDownloadButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
