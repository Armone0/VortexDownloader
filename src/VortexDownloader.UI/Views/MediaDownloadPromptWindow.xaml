<Window x:Class="VortexDownloader.UI.Views.MediaDownloadPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VortexDownloader - YouTube &amp; Medya İndir"
        MinHeight="600" Height="680" MaxHeight="820" Width="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Soft Deep Drop Shadow matching Soft Loft Dark Palette -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" Color="#000000" Opacity="0.55" ShadowDepth="4"/>

        <!-- Primary Action Button (Mat Adaçayı Yeşili / Sage Green #8EA191) -->
        <Style x:Key="PrimaryThemeButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Theme Button (Cancel, Queue, Browse) -->
        <Style x:Key="SecondaryThemeButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seal Style Format Selection Pill / Chip (Interactive RadioButton) -->
        <Style x:Key="SealFormatPillStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="12,8">
                            <Grid VerticalAlignment="Center">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="pillBorder" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Select Chip Button (for fragments) -->
        <Style x:Key="ChipButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource AccentHighlightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Toggle Button Template -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="8" SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource AccentHighlightBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          ClickMode="Press" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Left" IsHitTestVisible="false" 
                                              Margin="12,0,32,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource CardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" CornerRadius="8" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        SnapsToDevicePixels="true" Margin="0,4,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" 
                                Padding="{TemplateBinding Padding}" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow & Soft Loft Dark Theme Palette -->
    <Border Margin="14" CornerRadius="14" Background="{DynamicResource WindowBackgroundBrush}" 
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" 
            Effect="{StaticResource WindowShadow}" MouseLeftButtonDown="CardBorder_MouseLeftButtonDown">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <!-- Row 0: Header with Drag & Logo -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Scrollable Form Body -->
                <RowDefinition Height="*"/>
                <!-- Row 2: Action Footer Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== HEADER ==================== -->
            <Grid Grid.Row="0" Margin="0,0,0,16" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Soft Loft Logo Frame -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/vortex_logo.png" Margin="7" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="YOUTUBE &amp; MEDYA İNDİRİCİ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentHighlightBrush}" Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource AccentHighlightBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="yt-dlp &amp; FFmpeg Hızlı Akış" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentHighlightBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderStatus" Text="Video akış bilgileri taranıyor..." FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Width="30" Height="30" Background="Transparent" 
                        Foreground="{DynamicResource TextSecondaryBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- ==================== FORM BODY (SCROLLABLE) ==================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                          Focusable="False" Margin="0,0,-8,0" Padding="0,0,8,0">
                <StackPanel Margin="0,0,0,8">

                    <!-- 1. URL Giriş & Çözümleme Barı -->
                    <TextBlock Text="MEDYA VEYA VİDEO BAĞLANTISI (YOUTUBE, TWITTER/X, TIKTOK, INSTAGRAM, VB.)" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtMediaUrl" Style="{StaticResource ModernTextBoxStyle}" 
                                 Text="https://www.youtube.com/watch?v=..." FontSize="12" Margin="0,0,8,0" 
                                 TextChanged="TxtMediaUrl_TextChanged"/>
                        <Button Grid.Column="1" x:Name="BtnAnalyzeMedia" Content="⚡ Çözümle" 
                                Style="{StaticResource SecondaryThemeButton}" Padding="16,0" Click="BtnAnalyzeMedia_Click"/>
                    </Grid>

                    <!-- 2. Video Bilgi Kartı (Thumbnail, Başlık, Kanal & Süre Rozetleri) -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Thumbnail -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Video Info -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail Frame -->
                            <Border Grid.Column="0" Width="184" Height="104" CornerRadius="8" ClipToBounds="True" 
                                    Background="#181A1C" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,14,0">
                                <Grid>
                                    <!-- Asynchronous loaded thumbnail image -->
                                    <Image x:Name="ThumbnailImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- Placeholder / Loading indicator overlay -->
                                    <Grid x:Name="ThumbnailPlaceholder" Background="#222528" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🎬" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Kapak Resmi" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Duration Badge (Bottom-Right, Seal / YouTube style) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" 
                                            Background="#D91E2022" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtDurationBadge" Text="⏱️ --:--" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Video Details -->
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Video Title -->
                                <TextBlock Grid.Row="0" x:Name="TxtMediaTitle" 
                                           Text="Medya başlığı bekleniyor..." 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="{DynamicResource TextPrimaryBrush}" 
                                           TextWrapping="Wrap" MaxHeight="42" 
                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

                                <!-- Channel / Publisher & Engine Badges -->
                                <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                                    <!-- Channel Badge -->
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                            BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock x:Name="TxtChannel" Text="👤 Kanal: Yükleniyor..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>

                                    <!-- Duration Details Badge -->
                                    <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                            BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,6,4">
                                        <TextBlock x:Name="TxtDuration" Text="⏱️ Süre: Hesaplanıyor" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>

                                    <!-- Resolution / FPS Badge -->
                                    <Border Background="{DynamicResource BadgeBackgroundBrush}" BorderBrush="{DynamicResource AccentHighlightBrush}" 
                                            BorderThickness="1" CornerRadius="5" Padding="8,3" Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtMediaBadge" Text="⚡ yt-dlp Entegre" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentHighlightBrush}"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Subtitle / Stream Status Info -->
                                <TextBlock Grid.Row="2" x:Name="TxtStreamInfo" Text="En yüksek kaliteli video ve ses akışları otomatik birleştirilecektir." 
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 3. Kalite & Format Seçim Hapları (Seal Style Pills) -->
                    <TextBlock Text="KALİTE &amp; FORMAT SEÇİMİ (SEAL DİNAMİK HAPLARI)" 
                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="-4,0,-4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 🏆 4K / 2K Pill -->
                        <RadioButton Grid.Column="0" x:Name="Radio4K" GroupName="QualityGroup" 
                                     Style="{StaticResource SealFormatPillStyle}" Checked="QualityRadio_Checked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🏆" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="4K / 2K" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="En Yüksek Kalite" FontSize="10" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 📺 1080p Pill (Default / Recommended) -->
                        <RadioButton Grid.Column="1" x:Name="Radio1080p" GroupName="QualityGroup" IsChecked="True" 
                                     Style="{StaticResource SealFormatPillStyle}" Checked="QualityRadio_Checked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="📺" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="1080p" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Full HD MP4" FontSize="10" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 📱 720p Pill -->
                        <RadioButton Grid.Column="2" x:Name="Radio720p" GroupName="QualityGroup" 
                                     Style="{StaticResource SealFormatPillStyle}" Checked="QualityRadio_Checked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="📱" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="720p" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Hızlı HD" FontSize="10" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- 🎵 MP3 Pill (Audio Only) -->
                        <RadioButton Grid.Column="3" x:Name="RadioMP3" GroupName="QualityGroup" 
                                     Style="{StaticResource SealFormatPillStyle}" Checked="QualityRadio_Checked">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="🎵" FontSize="12" Margin="0,0,4,0"/>
                                    <TextBlock Text="MP3" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Ses (320 kbps)" FontSize="10" Opacity="0.85" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <!-- 4. Özel Formatlar Açılır Menüsü (ComboBox) -->
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="GELİŞMİŞ FORMAT &amp; KODLAMA SEÇENEKLERİ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbFormats" Style="{StaticResource ModernComboBoxStyle}" SelectionChanged="CmbFormats_SelectionChanged">
                            <ComboBoxItem Content="📺 1080p Full HD (MP4 - H.264 + AAC Ses)" Tag="1080p" IsSelected="True"/>
                            <ComboBoxItem Content="🏆 2160p 4K Ultra HD (WebM / MP4 - 60fps)" Tag="2160p"/>
                            <ComboBoxItem Content="🌟 1440p 2K QHD (WebM / MP4 - 60fps)" Tag="1440p"/>
                            <ComboBoxItem Content="📱 720p HD (MP4 - Hızlı İndirme)" Tag="720p"/>
                            <ComboBoxItem Content="🎞️ 480p SD Standart Çözünürlük (MP4)" Tag="480p"/>
                            <ComboBoxItem Content="💾 360p Düşük Veri Tasarrufu (MP4)" Tag="360p"/>
                            <ComboBoxItem Content="🎵 Sadece Ses: MP3 (320 kbps Yüksek Kalite)" Tag="mp3"/>
                            <ComboBoxItem Content="🎧 Sadece Ses: M4A / AAC (Orijinal YouTube Akışı)" Tag="m4a"/>
                            <ComboBoxItem Content="🎼 Sadece Ses: FLAC (Kayıpsız / Lossless Audio)" Tag="flac"/>
                            <ComboBoxItem Content="📻 Sadece Ses: OPUS (Ultra Verimli / 160 kbps)" Tag="opus"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 5. Kaydedilecek Dosya Adı & Hedef Klasör -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="KAYDEDİLECEK DOSYA ADI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtFileName" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="UZANTI" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                                    BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <TextBlock x:Name="TxtExtension" Text=".mp4" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentHighlightBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="KAYDEDİLECEK KLASÖR" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="TxtDestPath" Style="{StaticResource ModernTextBoxStyle}" 
                                 Foreground="{DynamicResource TextSecondaryBrush}" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" x:Name="BtnBrowseFolder" Content="Seç..." Style="{StaticResource SecondaryThemeButton}" 
                                Padding="18,0" Click="BtnBrowseFolder_Click"/>
                    </Grid>

                    <!-- 6. Dinamik Parça Sayısı (SliderConcurrentFragments, 1-16 arası, varsayılan 8) -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Eşzamanlı Parça / Akış Sayısı (Concurrent Fragments)" 
                                                   FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Border Width="16" Height="16" CornerRadius="8"
                                                Background="{DynamicResource InputBackgroundBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Cursor="Help"
                                                ToolTipService.InitialShowDelay="150">
                                            <Border.ToolTip>
                                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0" HasDropShadow="True">
                                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            MaxWidth="340">
                                                        <StackPanel>
                                                            <TextBlock Text="💡 Eşzamanlı Parça / Fragment İndirme (yt-dlp Engine)"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentHighlightBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Margin="0,0,0,6"/>
                                                            <TextBlock Text="YouTube ve medya sunucuları tek bağlantıda indirme hızını sınırlar. Eşzamanlı parçalar (concurrent fragments) ile video segmentleri paralel soketlerle aynı anda çekilir. Bu sayede indirme hızı 3 ile 8 kat artar. Normal bağlantılar için 8, yüksek hızlı fiber hatlar için 16 önerilir."
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Text="ℹ" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentHighlightBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-1,0,0"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="YouTube / CDN hız limitlerini aşmak için DASH &amp; HLS parçaları paralel indirilir" 
                                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>

                                <!-- Quick Select Chips -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Hızlı:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Button Content="1" Style="{StaticResource ChipButtonStyle}" Tag="1" Click="BtnChipFragment_Click"/>
                                    <Button Content="4" Style="{StaticResource ChipButtonStyle}" Tag="4" Click="BtnChipFragment_Click"/>
                                    <Button Content="8" Style="{StaticResource ChipButtonStyle}" Tag="8" Click="BtnChipFragment_Click"/>
                                    <Button Content="16" Style="{StaticResource ChipButtonStyle}" Tag="16" Click="BtnChipFragment_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Slider & Value Display -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderConcurrentFragments" Grid.Column="0" Minimum="1" Maximum="16" Value="8" 
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,12,0" 
                                        ValueChanged="SliderConcurrentFragments_ValueChanged"/>
                                <Border Grid.Column="1" Background="{DynamicResource ButtonPrimaryBgBrush}" CornerRadius="6" 
                                        Padding="12,3" MinWidth="40" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtFragmentCount" Text="8" FontSize="12" FontWeight="Bold" 
                                               Foreground="{DynamicResource ButtonPrimaryFgBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 7. Altyazı & Metadata Seçenekleri -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <CheckBox x:Name="ChkDownloadSubtitles" Content="Altyazıları dahil et (.srt / .vtt)" 
                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,18,0" Cursor="Hand"/>
                        <CheckBox x:Name="ChkEmbedMetadata" Content="Kapak resmini ve video etiketlerini (ID3 / MP4 Tags) göm" 
                                  IsChecked="True" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Cursor="Hand"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================== ACTION BUTTONS (FOOTER) ==================== -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Cancel Button -->
                <Button Grid.Column="0" Content="✕ İptal" IsCancel="True" Style="{StaticResource SecondaryThemeButton}" Click="BtnClose_Click"/>

                <!-- Right Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnQueue" Content="⏳ Kuyruğa Ekle" Style="{StaticResource SecondaryThemeButton}" Margin="0,0,10,0" Click="BtnQueue_Click"/>
                    <Button x:Name="BtnDownloadNow" Content="⚡ Vortex ile İndir" IsDefault="True" Style="{StaticResource PrimaryThemeButton}" Click="BtnDownloadNow_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
