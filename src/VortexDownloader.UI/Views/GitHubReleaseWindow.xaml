<Window x:Class="VortexDownloader.UI.Views.GitHubReleaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Sürümleri - VortexDownloader"
        Height="640" Width="760"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
        </Style>

        <Style x:Key="PickBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextMutedBrush}" Background="Transparent">
                            <TextBlock x:Name="mark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource ButtonPrimaryFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                <Border CornerRadius="11" Background="{DynamicResource AccentHighlightBrush}" Opacity="0.18"/>
                <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource AccentHighlightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderTitleText" Text="GitHub sürümleri" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="999" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Release dosyaları" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="RepoText" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Release picker + one-line facts -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReleaseCombo" IsEnabled="False" SelectionChanged="ReleaseCombo_SelectionChanged"
                          DisplayMemberPath="Label" Margin="0,0,14,0" AutomationProperties.Name="Sürüm"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="PreReleaseCheck" Style="{StaticResource PickBox}"
                              Click="PreReleaseCheck_Click" AutomationProperties.Name="Ön sürümleri göster"/>
                    <TextBlock Text="Ön sürümleri göster" Style="{StaticResource Muted}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DateText" Style="{StaticResource Muted}" Margin="2,10,0,0"/>
        </StackPanel>

        <!-- Assets + notes -->
        <Grid Grid.Row="2">
            <Border x:Name="StatusPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel>
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="4" MinWidth="280" Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource ProgressBarForegroundBrush}" BorderThickness="0" Margin="0,0,0,14"/>
                    <TextBlock x:Name="StatusText" Text="Sürümler okunuyor..." FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Button x:Name="RetryButton" Content="Yeniden dene" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="RetryButton_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="AssetsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MaxHeight="270"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <!-- Column header -->
                        <Grid DockPanel.Dock="Top" Margin="16,10,16,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="SelectAllCheck" Style="{StaticResource PickBox}" IsThreeState="True" Click="SelectAllCheck_Click"
                                      ToolTip="Tümünü seç / bırak" AutomationProperties.Name="Tümünü seç"/>
                            <TextBlock Grid.Column="1" Text="Dosya" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="44,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="Boyut" Style="{StaticResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="İndirme" Style="{StaticResource Muted}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardBorderBrush}"/>
                        <ListBox x:Name="AssetList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Background="Transparent" CornerRadius="7" Margin="6,1" Height="48">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- The whole row toggles the box -->
                                    <Grid Margin="10,0" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="AssetRow_Click">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="96"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Style="{StaticResource PickBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="AssetCheck_Click" Unchecked="AssetCheck_Click"
                                                  AutomationProperties.Name="{Binding Asset.Name}"/>
                                        <Border Grid.Column="1" Width="34" Height="30" CornerRadius="7" Margin="0,0,10,0" Background="{DynamicResource BadgeBackgroundBrush}">
                                            <TextBlock Text="{Binding ExtLabel}" FontSize="9.5" FontWeight="ExtraBold" Foreground="{DynamicResource BadgeTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Asset.Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Asset.Name}"/>
                                            <TextBlock Text="✓ SHA-256 doğrulanır" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource StatusCompletedBrush}"
                                                       Visibility="{Binding DigestVisibility}" ToolTip="GitHub bu dosyanın SHA-256 özetini yayınlıyor; indirme bitince otomatik karşılaştırılır."/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="4" Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Release notes fill the rest of the window -->
                <Border x:Name="NotesCard" Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Sürüm notları" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="16,10,16,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,12,12">
                            <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5" LineHeight="19" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontWeight="SemiBold" Text="Seçili: 0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Kapat" Margin="0,0,8,0" Click="CloseButton_Click"/>
                <Button x:Name="DownloadButton" Content="Seçilenleri indir" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="DownloadButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
