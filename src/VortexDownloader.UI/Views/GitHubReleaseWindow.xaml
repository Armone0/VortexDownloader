<Window x:Class="VortexDownloader.UI.Views.GitHubReleaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GitHub Sürümleri - VortexDownloader"
        Height="560" Width="720"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
        </Style>

        <Style x:Key="PickBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextMutedBrush}" Background="Transparent">
                            <TextBlock x:Name="mark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource ButtonPrimaryFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                <Border CornerRadius="11" Background="{DynamicResource AccentHighlightBrush}" Opacity="0.18"/>
                <TextBlock Text="🐙" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderTitleText" Text="GitHub sürümleri" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="999" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Release dosyaları" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="RepoText" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Release picker + notes -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ReleaseCombo" Height="34" IsEnabled="False" SelectionChanged="ReleaseCombo_SelectionChanged"
                          DisplayMemberPath="Label" Margin="0,0,12,0"/>
                <CheckBox x:Name="PreReleaseCheck" Grid.Column="1" Content="Ön sürümleri göster" VerticalAlignment="Center"
                          Foreground="{DynamicResource TextSecondaryBrush}" Click="PreReleaseCheck_Click"/>
            </Grid>
            <TextBlock x:Name="DateText" Style="{StaticResource Muted}" Margin="2,8,0,0"/>
            <Expander x:Name="NotesExpander" Header="Sürüm notları" Margin="0,6,0,0" Visibility="Collapsed"
                      Foreground="{DynamicResource TextSecondaryBrush}">
                <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </ScrollViewer>
            </Expander>
        </StackPanel>

        <!-- Assets -->
        <Grid Grid.Row="2">
            <Border x:Name="StatusPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel>
                    <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Height="4" MinWidth="280" Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource ProgressBarForegroundBrush}" BorderThickness="0" Margin="0,0,0,14"/>
                    <TextBlock x:Name="StatusText" Text="Sürümler okunuyor..." FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Button x:Name="RetryButton" Content="Yeniden dene" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" Click="RetryButton_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="AssetsPanel" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
                <ListBox x:Name="AssetList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="4,1" Height="38">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource PickBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Checked="AssetCheck_Click" Unchecked="AssetCheck_Click"
                                          AutomationProperties.Name="{Binding Asset.Name}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Asset.Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Asset.Name}"/>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="{Binding CountText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"
                                           ToolTip="İndirme sayısı"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Muted}" FontWeight="SemiBold" Text="Seçili: 0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Kapat" Margin="0,0,8,0" Click="CloseButton_Click"/>
                <Button x:Name="DownloadButton" Content="Seçilenleri indir" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="DownloadButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
