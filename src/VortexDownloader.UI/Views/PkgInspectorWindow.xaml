<Window x:Class="VortexDownloader.UI.Views.PkgInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PS4 PKG Bilgisi - VortexDownloader"
        Height="680" Width="820"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Base button: secondary look; primary/ghost variants below -->
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>

        <Style x:Key="Cell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selected row: tinted background + sage bar on the left so it reads clearly in both themes -->
        <Style x:Key="Row" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Grid>
                            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="4,1"/>
                            <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="4,7"
                                    Background="{DynamicResource AccentHighlightBrush}" Visibility="Collapsed"/>
                            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Themed checkbox: rounded box, sage fill + tick when checked, dash when partially checked (header) -->
        <Style x:Key="PickBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                BorderBrush="{DynamicResource TextMutedBrush}" Background="Transparent">
                            <TextBlock x:Name="mark" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource ButtonPrimaryFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE73E;"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="box" Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
                                <Setter TargetName="mark" Property="Text" Value="&#xE738;"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="box" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: sage tile + title + read-only badge, source below -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top">
                <Border CornerRadius="11" Background="{DynamicResource AccentHighlightBrush}" Opacity="0.18"/>
                <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           Foreground="{DynamicResource AccentHighlightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PS4 PKG bilgisi" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="999" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ModeBadgeText" Text="Salt okunur" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BadgeTextBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="SourceTextBlock" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Border x:Name="LoadingPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="26,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel MinWidth="300">
                    <ProgressBar IsIndeterminate="True" Height="4" Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource ProgressBarForegroundBrush}" BorderThickness="0" Margin="0,0,0,14"/>
                    <TextBlock Text="PKG başlığı okunuyor..." FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusErrorBrush}" BorderThickness="1" CornerRadius="10" Padding="22,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PKG okunamadı" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="ErrorMessageText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>
                    <Button Content="Yeniden dene" HorizontalAlignment="Center" Click="RetryButton_Click"/>
                </StackPanel>
            </Border>

            <Grid x:Name="ContentPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Metadata card: icon0 + key fields -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="128" Height="128" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Top"
                                Background="{DynamicResource InputBackgroundBrush}" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="NoIconText" Text="Simge yok" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="IconImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="FieldsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     Background="Transparent" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Entries -->
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="1">
                    <DataGrid x:Name="EntriesDataGrid"
                              SelectionMode="Single"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                              BorderThickness="0"
                              ColumnHeaderStyle="{StaticResource ColumnHeader}"
                              CellStyle="{StaticResource Cell}"
                              RowStyle="{StaticResource Row}"
                              CanUserSortColumns="True" CanUserResizeColumns="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource PickBox}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsSelectable}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Dosya" Binding="{Binding Name}" Width="*" MinWidth="220"/>
                            <DataGridTextColumn Header="Kimlik" Binding="{Binding IdText}" Width="90" ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Boyut" Binding="{Binding SizeText}" Width="110"
                                                SortMemberPath="Size" ElementStyle="{StaticResource NumberCell}"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding StateText}" Width="100" ElementStyle="{StaticResource NumberCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Full PARAM.SFO, collapsed by default -->
                <Expander x:Name="SfoExpander" Grid.Row="2" Header="PARAM.SFO (tüm alanlar)" Margin="0,10,0,0"
                          Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold">
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="1" Margin="0,6,0,0" MaxHeight="220">
                        <DataGrid x:Name="SfoDataGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                  BorderThickness="0" FontWeight="Normal"
                                  ColumnHeaderStyle="{StaticResource ColumnHeader}"
                                  CellStyle="{StaticResource Cell}"
                                  RowStyle="{StaticResource Row}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Anahtar" Binding="{Binding Key}" Width="200"/>
                                <DataGridTextColumn Header="Değer" Binding="{Binding Text}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Expander>
            </Grid>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHintText" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"
                       Text="Yalnızca şifresiz dosyalar çıkarılabilir; şifreli içerik çözülmez."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExtractButton" Content="Seçilenleri çıkar" IsEnabled="False" Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButton}" Click="ExtractButton_Click"/>
                <Button x:Name="CloseButton" Content="Kapat" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
