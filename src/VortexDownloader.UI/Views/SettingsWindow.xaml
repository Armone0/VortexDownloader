<Window x:Class="VortexDownloader.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VortexDownloader - Ayarlar"
        Height="570" Width="740"
        MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Tab RadioButton Style (No Dotted Focus Outline) -->
        <Style x:Key="SettingsTabButtonStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox Toggle Button -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" SnapsToDevicePixels="true">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource TextSecondaryBrush}" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource AccentHighlightBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Modern ComboBox Style -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="true">
                            <ToggleButton x:Name="toggleButton" Background="{TemplateBinding Background}" 
                                          BorderBrush="{TemplateBinding BorderBrush}" 
                                          BorderThickness="{TemplateBinding BorderThickness}" 
                                          ClickMode="Press" Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"/>
                            <ContentPresenter x:Name="contentPresenter" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" 
                                              HorizontalAlignment="Left" IsHitTestVisible="false" 
                                              Margin="10,0,26,0" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="true" Focusable="false" 
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="{DynamicResource CardBackgroundBrush}" 
                                        BorderBrush="{DynamicResource CardBorderBrush}" 
                                        BorderThickness="1" CornerRadius="6" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}" 
                                        MinWidth="{Binding ActualWidth, ElementName=templateRoot}" 
                                        SnapsToDevicePixels="true" Margin="0,3,0,0">
                                    <ScrollViewer x:Name="DropDownScrollViewer">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" 
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" Margin="2"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" 
                                Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save Button Style (High Contrast & Proper Padding) -->
        <Style x:Key="SaveActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Padding" Value="24,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel / Secondary Button Style (High Contrast & Proper Padding) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="24,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonSecondaryFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonSecondaryBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonSecondaryBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource HoverTintBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style (Guaranteed 10px spacing between check border and text) -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" Grid.Column="0" Width="18" Height="18" CornerRadius="4" 
                                    Background="{DynamicResource InputBackgroundBrush}" 
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path x:Name="checkMark" Data="M 3 8 L 7 12 L 14 4" 
                                      Stroke="{DynamicResource AccentHighlightBrush}" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="True" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN TWO-COLUMN SETTINGS LAYOUT -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Tabs Navigation -->
            <ColumnDefinition Width="190"/>
            <!-- Right Settings Details Work Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT TAB SIDEBAR -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" 
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,18,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Settings Title -->
                <TextBlock Grid.Row="0" Text="{DynamicResource Str_Settings}" FontSize="15" FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,14"/>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="TabBtnGeneral" Style="{StaticResource SettingsTabButtonStyle}" 
                                 IsChecked="True" GroupName="SettingsTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Str_General}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnAppearance" Style="{StaticResource SettingsTabButtonStyle}" 
                                 GroupName="SettingsTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎨" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Str_Appearance}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="TabBtnAbout" Style="{StaticResource SettingsTabButtonStyle}" 
                                 GroupName="SettingsTabs">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ️" FontSize="13" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource Str_About}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Version chip at bottom -->
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" 
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <TextBlock Text="VORTEX v1.4" FontSize="10" FontWeight="Bold" 
                               Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT CONTENT AREA -->
        <Grid Grid.Column="1" Margin="24,20,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TAB 1: GENEL (GENERAL) -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=TabBtnGeneral, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{DynamicResource Str_General}" FontSize="17" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <!-- Download Directory Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_DefaultFolder}" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3"/>
                            <TextBlock Text="İndirilen dosyaların otomatik kaydedileceği klasör yolu" FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDefaultFolder" Grid.Column="0" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0"/>
                                <Button x:Name="BtnBrowseFolder" Grid.Column="1" Style="{StaticResource SecondaryButton}" 
                                        Content="{DynamicResource Str_Browse}" Click="BtnBrowseFolder_Click" Height="32"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Concurrency & Chunks Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Max Concurrent Downloads -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Str_MaxConcurrent}" FontWeight="SemiBold" FontSize="13" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Aynı anda aktif indirilen maksimum görev sayısı" FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbMaxConcurrent" Grid.Column="1" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="1 Görev" Tag="1"/>
                                    <ComboBoxItem Content="2 Görev" Tag="2"/>
                                    <ComboBoxItem Content="3 Görev" Tag="3"/>
                                    <ComboBoxItem Content="5 Görev" Tag="5"/>
                                    <ComboBoxItem Content="Sınırsız" Tag="0"/>
                                </ComboBox>
                            </Grid>

                            <!-- Default Chunk Count -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{DynamicResource Str_DefaultChunks}" FontWeight="SemiBold" FontSize="13" 
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Dosya başına açılan eşzamanlı soket parçası" FontSize="11" 
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbDefaultChunks" Grid.Column="1" Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="4 Parça" Tag="4"/>
                                    <ComboBoxItem Content="8 Parça" Tag="8"/>
                                    <ComboBoxItem Content="16 Parça" Tag="16"/>
                                    <ComboBoxItem Content="32 Parça" Tag="32"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Automation & Tray Behavior Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="ChkAutoStartBrowserDownloads" Style="{StaticResource ModernCheckBox}" 
                                      Content="Tarayıcı indirmelerini onay sormadan doğrudan başlat (Zero-Click Auto-Start)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Tarayıcı uzantısından gelen indirmeleri onay penceresi beklemeden doğrudan varsayılan klasöre ve en yüksek hızla başlatır." 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,0,0,12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="ChkCloseToTray" Style="{StaticResource ModernCheckBox}" 
                                      Content="Pencere kapatıldığında sistem tepsisine küçült (Arka planda çalış)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Pencere kapatıldığında indirmelerin arka planda devam etmesini ve tarayıcı indirmelerinin yakalanmasını sağlar." 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,0,0,12" TextWrapping="Wrap"/>

                            <CheckBox x:Name="ChkShutdownWhenDone" Style="{StaticResource ModernCheckBox}" 
                                      Content="{DynamicResource Str_ShutdownWhenDone}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Tüm görevler bittiğinde bilgisayarı otomatik olarak güvenle kapatır." 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="26,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: GÖRÜNÜM & DİL (APPEARANCE & LANGUAGE - NO TRUNCATION & BALANCED LAYOUT) -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=TabBtnAppearance, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{DynamicResource Str_Appearance}" FontSize="17" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                    <!-- Theme Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Str_Theme}" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Arayüz renk temasını anında dinamik olarak günceller" FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbTheme" Grid.Column="1" Style="{StaticResource ModernComboBox}" 
                                      SelectionChanged="CmbTheme_SelectionChanged">
                                <ComboBoxItem Content="{DynamicResource Str_DarkMode}" Tag="Dark"/>
                                <ComboBoxItem Content="{DynamicResource Str_LightMode}" Tag="Light"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Language Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Str_Language}" FontWeight="SemiBold" FontSize="13" 
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Uygulama dilini anında dinamik olarak değiştirir" FontSize="11" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" Style="{StaticResource ModernComboBox}" 
                                      SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Content="Türkçe (TR)" Tag="tr"/>
                                <ComboBoxItem Content="English (EN)" Tag="en"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Visual Polish / Behavior Card (Dolu ve Dengeli Tasarım) -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Ekran ve Bildirim Tercihleri" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <CheckBox Content="İndirme tamamlandığında Windows masaüstü bildirimi göster" 
                                      Style="{StaticResource ModernCheckBox}" IsChecked="True" Margin="0,0,0,6"/>
                            <CheckBox Content="Pencere kapatıldığında arka planda sistem tepsisine (Tray) küçült" 
                                      Style="{StaticResource ModernCheckBox}" IsChecked="{Binding IsChecked, ElementName=ChkCloseToTray, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 3: HAKKINDA (ABOUT - PENCEREYE TAM SIĞAR, ÇİFT KAYDIRMA YOK) -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChecked, ElementName=TabBtnAbout, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="{DynamicResource Str_About}" FontSize="17" FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                    <!-- Main Brand Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/vortex_logo.png" Width="48" Height="48" Margin="0,0,0,8" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="VORTEX DOWNLOADER" FontSize="15" FontWeight="Black" 
                                       Foreground="{DynamicResource AccentHighlightBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="v1.5.0 • Professional Edition" FontSize="11" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                            <TextBlock Text="&quot;Veriyi bekleme; onu girdaba çek.&quot;" FontStyle="Italic" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Çok kanallı dinamik bisection ile son %1 darboğazını yok eden ve veriyi merkeze çeken yüksek performanslı indirme yöneticisi." 
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440"/>
                        </StackPanel>
                    </Border>

                    <!-- Engine Specs Card -->
                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <TextBlock Text="🚀 Motor Mimarisi" FontWeight="SemiBold" FontSize="12" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="• SocketsHttpHandler Zero-Alloc" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="• Dinamik Çok Kanallı Bisection" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="• SHA-256 Otomatik Doğrulama" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="• Yerel Tarayıcı Köprüsü (Port 19741)" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- BOTTOM ACTION BUTTONS (Geniş, Ferah & Yüksek Kontrast) -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str_Cancel}" 
                            Margin="0,0,12,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnSave" Style="{StaticResource SaveActionButton}" Content="{DynamicResource Str_SaveAndClose}" 
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
