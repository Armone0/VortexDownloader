<Window x:Class="VortexDownloader.UI.Views.DownloadPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VortexDownloader - Yeni İndirme"
        Height="440" Width="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Modern Glow Border Effect -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="28" Color="#00F2FE" Opacity="0.25" ShadowDepth="0"/>

        <!-- Action Button Style -->
        <Style x:Key="PrimaryGradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="#090D16"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#00F2FE" Offset="0.0"/>
                                    <GradientStop Color="#4FACFE" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryDarkButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderBrush="#334155" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2D3B55"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Container with Shadow -->
    <Border Margin="14" CornerRadius="14" Background="#0C101B" BorderBrush="#1E293B" BorderThickness="1" Effect="{StaticResource WindowShadow}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <!-- Header with Drag and Logo -->
                <RowDefinition Height="Auto"/>
                <!-- Form Inputs -->
                <RowDefinition Height="*"/>
                <!-- Footer Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Abstract Logo Thumbnail -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00F2FE" Offset="0"/>
                            <GradientStop Color="#7F00FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Image Source="pack://application:,,,/Assets/vortex_logo.png" Margin="6" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Titles -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="YENİ İNDİRME YAKALANDI" FontSize="11" FontWeight="Bold" Foreground="#00F2FE" Margin="0,0,8,0"/>
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Tarayıcı Yakalama" FontSize="10" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHeaderFileName" Text="Dosya bilgisi alınıyor..." FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="2" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="14" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>

            <!-- Form Body -->
            <StackPanel Grid.Row="1" Margin="0,4,0,16">
                <!-- URL Display Card -->
                <Border Background="#141C2E" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔗" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtUrl" Text="https://..." FontSize="12" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- File Info Details -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Save As File Name -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="KAYDEDİLECEK DOSYA ADI" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtFileName" Background="#141C2E" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="13" TextChanged="TxtFileName_TextChanged"/>
                    </StackPanel>

                    <!-- File Size Pill -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="BOYUT" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <Border Background="#1E293B" CornerRadius="6" Padding="14,8" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock x:Name="TxtFileSize" Text="Hesaplanıyor..." FontSize="13" FontWeight="Bold" Foreground="#00F2FE"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Destination Directory -->
                <TextBlock Text="KAYDEDİLECEK KLASÖR" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="TxtDestPath" Background="#141C2E" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="10,8" FontSize="12" IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Seç..." Style="{StaticResource SecondaryDarkButton}" Click="BtnBrowseFolder_Click"/>
                </Grid>

                <!-- Dynamic Chunk Count Selection -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Dinamik Bağlantı Kanalı (Parça Sayısı)" FontSize="12" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Bant genişliğini sonuna kadar doyurmak için paralel kanal açılır" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider x:Name="SliderChunks" Minimum="1" Maximum="32" Value="8" Width="140" Margin="0,0,10,0" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderChunks_ValueChanged"/>
                        <Border Background="#00F2FE" CornerRadius="4" Padding="8,2" Width="36" HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtChunkCount" Text="8" FontSize="12" FontWeight="Bold" Foreground="#090D16" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Daha Sonra İndir (Kuyruğa Ekle)" Style="{StaticResource SecondaryDarkButton}" HorizontalAlignment="Left" Click="BtnQueue_Click"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="İptal" Style="{StaticResource SecondaryDarkButton}" Margin="0,0,10,0" Click="BtnClose_Click"/>
                    <Button Content="⚡ Hemen İndir" Style="{StaticResource PrimaryGradientButton}" Click="BtnDownloadNow_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
