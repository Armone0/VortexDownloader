<Window x:Class="VortexDownloader.UI.Views.VortexSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Telefondan gönder"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">
    <StackPanel Margin="22,18,22,18">
        <TextBlock Text="📱 Telefondan gönder" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Telefon bu bilgisayarla aynı Wi-Fi ağında olmalı. Kodu telefon kamerasıyla okut, açılan sayfaya bağlantıyı yapıştır. İndirme yalnızca burada onaylarsan başlar."/>

        <Border Margin="0,14,0,0" Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Border>

        <TextBox x:Name="UrlText" Margin="0,12,0,0" IsReadOnly="True" BorderThickness="1" Padding="8,6"
                 FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                 Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource CardBorderBrush}"/>

        <TextBlock x:Name="CountdownText" Margin="0,10,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource AccentHighlightBrush}"/>
        <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Windows Güvenlik Duvarı ilk seferde izin isteyebilir; yalnızca Özel ağlara izin verin."/>

        <Button Content="Kapat" IsCancel="True" HorizontalAlignment="Right" Margin="0,14,0,0" MinWidth="92" Height="34" Click="Close_Click"/>
    </StackPanel>
</Window>
